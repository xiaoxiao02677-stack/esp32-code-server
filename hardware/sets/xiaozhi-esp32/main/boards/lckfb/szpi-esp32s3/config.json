{
    "manufacturer": "lckfb",
    "type": "lichuang-dev",
    "target": "esp32s3",
    "builds": [
        {
            "name": "lichuang-dev",
            "sdkconfig_append": [
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_CAMERA_PSRAM_DMA=y",
                "CONFIG_USE_AUDIO_PROCESSOR=y",
                "CONFIG_USE_SERVER_AEC=n",
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m.csv\"",
                "CONFIG_ESPTOOLPY_FLASHMODE_DIO=y",
                "CONFIG_ESPTOOLPY_FLASHMODE_QIO=n",
                "CONFIG_YH_PROTOCOL_ENABLED=y",
                "CONFIG_YH_SERVER_HOST=\"sandyun.top\"",
                "CONFIG_YH_SERVER_PORT=12399",
                "CONFIG_OTA_URL=\"http://sandyun.top:8002/xiaozhi/ota/\"",
                "CONFIG_USE_CUSTOM_WAKE_WORD=y",
                "CONFIG_SR_MN_CN_MULTINET7_QUANT=y",
                "CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n",
                "CONFIG_CUSTOM_WAKE_WORD=\"ni hao xiao he\"",
                "CONFIG_CUSTOM_WAKE_WORD_DISPLAY=\"你好小禾\"",
                "CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=40"
            ]
        }
    ]
}
