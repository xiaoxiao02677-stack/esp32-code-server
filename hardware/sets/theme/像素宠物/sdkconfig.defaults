# ── Target / PSRAM（ESP32-S3 + 8MB PSRAM 推荐）
CONFIG_IDF_TARGET="esp32s3"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ── 编译器：v6.x 警告即错误，这里关掉"警告升级"以便快速跑通；稳定后可自行打开
CONFIG_COMPILER_WARN_WRITE_STRINGS=n

# ── LVGL 9
CONFIG_LV_USE_CANVAS=y
CONFIG_LV_USE_BAR=y
CONFIG_LV_USE_LABEL=y
CONFIG_LV_USE_BTN=y
CONFIG_LV_USE_ARC=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_SIMSUN_16_CJK=y
CONFIG_LV_DEF_REFR_PERIOD=33
CONFIG_LV_USE_LOG=n

# LVGL 内存放 PSRAM
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEM_BUF_MAX_NUM=32

# ── FreeRTOS tick（LVGL 需要 1ms tick）
CONFIG_FREERTOS_HZ=1000

# ── 日志
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ── 主任务栈（开机动画 + LVGL 都在 main task 之外跑）
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
