<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="xiaozhi.modules.sys.dao.SysAuditLogDao">

    <select id="selectDistinctModules" resultType="java.lang.String">
        select distinct module from sys_audit_log
        where module is not null
        order by module asc
    </select>

</mapper>
