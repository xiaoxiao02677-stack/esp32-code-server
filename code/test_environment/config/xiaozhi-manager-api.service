[Unit]
Description=XiaoZhi Manager API (Spring Boot)
After=network-online.target mysql.service redis-server.service
Wants=network-online.target
Requires=mysql.service redis-server.service

[Service]
Type=simple
WorkingDirectory=/opt/xiaozhi
ExecStart=/usr/bin/java -jar /opt/xiaozhi/xiaozhi-esp32-api.jar --spring.profiles.active=dev
Restart=on-failure
RestartSec=8
StandardOutput=append:/opt/xiaozhi/manager-api.log
StandardError=append:/opt/xiaozhi/manager-api.log

[Install]
WantedBy=multi-user.target
