[Unit]
# 端口规划（2026-10-13）：测试环境对外端口 8100-8200（生产 8000-8100）
#   8101 nginx -> Python WS:8000 / HTTP:8003 / Java:8002
#   8102 nginx health check
#   8104 nginx stream -> MySQL:3306
#   8105 nginx stream -> Redis:6379
#   8144 nginx TLS -> 同 8101
#   8199 TCP/UDP -> Python 心跳
Description=XiaoZhi Manager API (Spring Boot) - TEST
After=network-online.target mysql.service redis-server.service
Wants=network-online.target
Requires=mysql.service redis-server.service

[Service]
Type=simple
WorkingDirectory=/root/yh/deploy/opt-xiaozhi
# jar 由 JDK21 编译（class file 65.0），必须用 Java 21 运行
ExecStart=/usr/lib/jvm/java-21-openjdk-amd64/bin/java -jar /root/yh/deploy/opt-xiaozhi/xiaozhi-esp32-api.jar --spring.profiles.active=dev
Restart=on-failure
RestartSec=8
StandardOutput=append:/root/yh/deploy/opt-xiaozhi/manager-api.log
StandardError=append:/root/yh/deploy/opt-xiaozhi/manager-api.log

[Install]
WantedBy=multi-user.target
