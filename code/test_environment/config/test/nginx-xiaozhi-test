# ============================================================
# 测试环境 nginx 站点（sandyun.top 测试 VM 专用）
# ------------------------------------------------------------
# 端口规划（2026-10-13）：测试环境对外端口范围 8100-8200（生产 8000-8100）
#   8101 明文 -> 设备 ws://sandyun.top:8101/xiaozhi/v1/ + 页面（原 8001）
#   8144 TLS  -> 浏览器 https（自签名证书，仅测试用）（原 9444）
# 内部端口不变：Python 8000(WS)/8003(HTTP)、Java 8002
# ============================================================
server {
    listen 8101;
    listen 8144 ssl;

    ssl_certificate /etc/nginx/ssl/sandyun.top.crt;
    ssl_certificate_key /etc/nginx/ssl/sandyun.top.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    server_name _;

    include /etc/nginx/snippets/xiaozhi-common.conf;

    # 视觉分析接口（原 8003 直连，现经 8101 对外）
    location /mcp/ {
        proxy_pass http://127.0.0.1:8003;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
