# ============================================================
# 测试环境 nginx 站点（sandyun.top 测试 VM 专用）
# ------------------------------------------------------------
# 端口规划（2026-10-13）：测试环境对外端口范围 8100-8200（生产 8000-8100）
#   8101 明文 -> 设备 ws://sandyun.top:8101/xiaozhi/v1/ + 页面（原 8001）
#   8102 明文 -> 健康检查（新增）
#   8104 stream -> MySQL 3306 代理（新增）
#   8105 stream -> Redis 6379 代理（新增）
#   8144 TLS  -> 浏览器 https（自签名证书，仅测试用）（原 9444）
#   8199 TCP/UDP -> Python 心跳
# 内部端口不变：Python WS:8000 / HTTP:8003, Java:8002
# ------------------------------------------------------------
server {
    listen 8101;
    listen 8144 ssl;

    ssl_certificate /etc/nginx/ssl/sandyun.top.crt;
    ssl_certificate_key /etc/nginx/ssl/sandyun.top.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    server_name _;

    root /var/www/xiaozhi-manager;
    index index.html;

    # Push API 反代到 Python 8003
    location /api/push {
        proxy_pass http://127.0.0.1:8003;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization $http_authorization;
    }

    # 设备 WebSocket 反代
    location /xiaozhi/v1/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 10s;
    }

    # 视觉分析接口反代到 Python 8003
    location /mcp/ {
        proxy_pass http://127.0.0.1:8003;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization $http_authorization;
    }

    # 管理接口透传（其余 /xiaozhi/* 到 Java 8002）
    location /xiaozhi/ {
        proxy_pass http://127.0.0.1:8002/xiaozhi/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # console-v2：客户端
    location = / {
        root /var/www/console-v2/app;
        try_files /index.html =404;
    }
    location /assets/ {
        root /var/www/console-v2/app;
        try_files $uri =404;
    }

    # console-v2：管理端
    location /admincc/ {
        alias /var/www/console-v2/admin/;
        index index.html;
        try_files $uri $uri/ /admincc/index.html;
    }
    location /admin/ {
        alias /var/www/console-v2/admin/;
        index index.html;
        try_files $uri $uri/ /admin/index.html;
    }

    # 独立 API 控制台
    location /cc/ {
        alias /var/www/cc-console/;
        index index.html;
        try_files $uri $uri/ /cc/index.html;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ============================================================
# 健康检查（8102）
# ============================================================
server {
    listen 8102;
    server_name _;
    location /health {
        return 200 '{"status":"ok"}';
        add_header Content-Type application/json;
    }
}

# ============================================================
# Stream 代理（TCP/UDP，非 HTTP）
# ============================================================

# MySQL 代理：外部 8104 -> 内部 3306
stream {
    upstream mysql_backend {
        server 127.0.0.1:3306;
    }
    server {
        listen 8104;
        proxy_pass mysql_backend;
        proxy_timeout 10s;
        proxy_connect_timeout 5s;
    }

    # Redis 代理：外部 8105 -> 内部 6379
    upstream redis_backend {
        server 127.0.0.1:6379;
    }
    server {
        listen 8105;
        proxy_pass redis_backend;
        proxy_timeout 10s;
        proxy_connect_timeout 5s;
    }

    # Python 心跳（TCP/UDP）
    server {
        listen 8199;
        proxy_pass 127.0.0.1:8199;
    }
}
