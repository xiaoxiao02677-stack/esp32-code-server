    {"button": "启用/禁用", "event": "toggleModel", "apis": ["PUT /models/enable/{id}/{status}"]},
    {"button": "编辑", "event": "saveModelConfig", "apis": ["PUT /models/{type}/{provider}/{id}"]},
    {"button": "删除", "event": "deleteModelConfig", "apis": ["DELETE /models/{id}"]},
    {"button": "设为默认", "event": "setDefaultModel", "apis": ["PUT /models/default/{id}"]},
    {"button": "新增供应器", "event": "addModelProvider", "apis": ["POST /models/provider"]},
    {"button": "一键测试", "event": "testModel", "apis": ["POST /api/model/test"]}
  ],
  "params": [
    {"button": "刷新", "event": "loadParams", "apis": ["GET /admin/params/page"]},
    {"button": "编辑", "event": "saveParam", "apis": ["PUT /admin/params"]},
    {"button": "新增", "event": "addParam", "apis": ["POST /admin/params"]},
    {"button": "删除", "event": "deleteParam", "apis": ["POST /admin/params/delete"]}
  ],
  "users": [
    {"button": "刷新", "event": "loadUsers", "apis": ["GET /admin/users"]},
    {"button": "启用/禁用", "event": "toggleUserStatus", "apis": ["PUT /admin/users/changeStatus/{status}"]},
    {"button": "重置密码", "event": "resetUserPassword", "apis": ["PUT /admin/users/{id}"]},
    {"button": "删除", "event": "deleteUser", "apis": ["DELETE /admin/users/{id}"]}
  ],
  "ota": [
    {"button": "刷新", "event": "loadOta", "apis": ["GET /otaMag"]},
    {"button": "上传固件", "event": "uploadFirmware", "apis": ["POST /otaMag/upload"]},
    {"button": "编辑", "event": "saveOta", "apis": ["PUT /otaMag/{id}"]},
    {"button": "删除", "event": "deleteOta", "apis": ["DELETE /otaMag/{id}"]},
    {"button": "下载", "event": "downloadOta", "apis": ["GET /otaMag/download/{id}"]}
  ],
  "dicts": [
    {"button": "刷新", "event": "loadDicts", "apis": ["GET /admin/dict/type/page"]},
    {"button": "加载字典数据", "event": "loadDictData", "apis": ["GET /admin/dict/data/type/{dictType}"]},
    {"button": "新增/编辑", "event": "saveDictData", "apis": ["POST /admin/dict/data/save", "POST /admin/dict/data/update"]},
    {"button": "删除", "event": "deleteDictData", "apis": ["POST /admin/dict/data/delete"]}
  ],
  "servers": [
    {"button": "刷新", "event": "loadServers", "apis": ["GET /admin/server/server-list"]},
    {"button": "下发指令", "event": "sendWsServerAction", "apis": ["POST /admin/server/emit-action"]}
  ],
  "simulator": [
    {"button": "启动模拟", "event": "startSimulation", "apis": ["POST /api/asr/recognize"]},
    {"button": "停止", "event": "stopSimulation", "apis": []}
  ],
  "apis": [
    {"button": "发送请求", "event": "sendRequest", "apis": ["动态: API_CATALOG"]}
  ],
  "global": [
    {"button": "退出登录", "event": "doLogout", "apis": ["(本地清除 token)"]},
    {"button": "主题切换", "event": "setTheme", "apis": ["(本地 localStorage)"]},
    {"button": "紧凑/宽松切换", "event": "compactMode toggle", "apis": []},
    {"button": "登录", "event": "doLogin", "apis": ["POST /user/login", "GET /user/pub-config", "GET /user/captcha"]}
  ]
}
