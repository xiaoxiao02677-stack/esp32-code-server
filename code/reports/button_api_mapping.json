{
  "overview": [
    {"button": "刷新总览", "event": "loadAll", "apis": ["GET /agent/list", "GET /models/list?modelType=TTS", "POST /device/bind/{agentId}"]}
  ],
  "agents": [
    {"button": "刷新", "event": "loadAgents", "apis": ["GET /agent/list"]},
    {"button": "查看聊天", "event": "openChat", "apis": ["GET /agent/{agentId}/sessions"]},
    {"button": "编辑", "event": "openAgentEdit", "apis": ["GET /agent/{agentId}", "GET /models/names?modelType=*", "GET /models/{ttsModelId}/voices", "POST /device/bind/{agentId}"]},
    {"button": "删除", "event": "deleteAgent", "apis": ["DELETE /agent/{agentId}"]},
    {"button": "＋ 新建智能体", "event": "createAgent", "apis": ["GET /models/names?modelType=*"]},
    {"button": "保存", "event": "saveAgent/persistAgent", "apis": ["POST /agent", "PUT /agent/{agentId}"]},
    {"button": "绑定设备(6位码)", "event": "bindDeviceByCode", "apis": ["POST /device/bind/{agentId}/{code}"]},
    {"button": "手动添加设备", "event": "manualAddDevice", "apis": ["POST /device/manual-add"]},
    {"button": "解绑设备", "event": "unbindAgentDevice", "apis": ["POST /device/unbind"]}
  ],
  "templates": [
    {"button": "刷新", "event": "loadTemplates", "apis": ["GET /agent/template/page"]},
    {"button": "从模板创建", "event": "createAgentFromTemplate", "apis": ["POST /agent", "GET /agent/template"]},
    {"button": "编辑模板", "event": "editTemplate", "apis": ["PUT /agent/template"]},
    {"button": "删除模板", "event": "deleteTemplate", "apis": ["DELETE /agent/template/{id}"]}
  ],
  "mcp": [
    {"button": "刷新", "event": "loadMcpInfo", "apis": ["GET /agent/mcp/address/{agentId}", "GET /agent/mcp/tools/{agentId}"]}
  ],
