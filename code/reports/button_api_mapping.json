    {"button": "召回测试", "event": "retrievalTest", "apis": ["POST /datasets/{id}/retrieval-test"]}
  ],
  "correctwords": [
    {"button": "刷新", "event": "loadCorrectFiles", "apis": ["GET /correct-word/file/list"]},
