    {"button": "下载", "event": "downloadCorrectFile", "apis": ["GET /correct-word/file/download/{id}"]}
  ],
  "voices": [
    {"button": "刷新音色", "event": "loadVoices", "apis": ["GET /models/{voiceTtsModel}/voices"]},
    {"button": "试听", "event": "playVoice", "apis": ["GET /models/ttsPreview"]},
    {"button": "新增音色", "event": "saveVoice", "apis": ["POST /ttsVoice"]},
    {"button": "编辑音色", "event": "saveVoice", "apis": ["PUT /ttsVoice/{id}"]},
    {"button": "删除音色", "event": "deleteVoice", "apis": ["POST /ttsVoice/delete"]}
  ],
  "chat": [
    {"button": "刷新会话", "event": "reloadChatSessions", "apis": ["GET /agent/{agentId}/sessions"]},
    {"button": "加载聊天记录", "event": "loadChatHistory", "apis": ["GET /agent/{agentId}/chat-history/{sessionId}"]},
    {"button": "播放音频", "event": "playChatAudio", "apis": ["POST /agent/audio/{audioId}", "GET /voiceClone/play/{id}"]},
    {"button": "删除会话", "event": "deleteChatSession", "apis": ["DELETE /agent/{agentId}/chat-history/{sessionId}"]}
  ],
  "devices": [
    {"button": "刷新", "event": "loadAllDevices", "apis": ["GET /admin/device/all"]},
