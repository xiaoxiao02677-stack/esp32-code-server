# Super-small-screen: ESP32-S3 + 0.42" SSD1306 OLED + WiFi/WS 客户端
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 自定义分区表：nvs 24K + phy 4K + factory 2MB（剩余 ~2MB 预留未来 OTA/fatfs）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"

# WiFi（v6.x 默认已启用 esp_wifi/nvs/netif，此处显式确认，防止 defaults 被裁）
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y

# lwIP / TCP IP 栈保持默认（SDK 自带）；ws:// 明文无需 esp-tls
